 			cannotBePartial();
-			if (values == nullptr) {
-				throw std::invalid_argument("The array of values cannot be null");
+			if constexpr (std::is_pointer_v<Buffer>) {
+				if (values == nullptr) {
+					throw std::invalid_argument("The array of values cannot be null");
+				}
 			}
 
 			T nullValue;
@@ -296,11 +337,7 @@ namespace RESQML2_NS
