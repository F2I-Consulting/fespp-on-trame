index 02f7281..562ecc7 100644
--- a/src/common/AbstractObject.cpp
+++ b/src/common/AbstractObject.cpp
@@ -1514,6 +1514,10 @@ template<> uint32_t AbstractObject::readArrayNdOfIntegerValues(gsoap_eml2_3::eml
 template<> int64_t AbstractObject::readArrayNdOfIntegerValues(gsoap_eml2_3::eml23__AbstractValueArray const* arrayInput, COMMON_NS::Span<int64_t> arrayOutput) const { return readIntegerValuesSized(arrayInput, arrayOutput); }
 template<> uint64_t AbstractObject::readArrayNdOfIntegerValues(gsoap_eml2_3::eml23__AbstractValueArray const* arrayInput, COMMON_NS::Span<uint64_t> arrayOutput) const { return readIntegerValuesSized(arrayInput, arrayOutput); }
 
+uint64_t AbstractObject::getCountOfDataArrayPart(gsoap_eml2_3::eml23__ExternalDataArrayPart const* dataArrayPart)
+{
+	return std::accumulate(std::begin(dataArrayPart->Count), std::end(dataArrayPart->Count), static_cast<uint64_t>(1), std::multiplies<uint64_t>());
+}
 uint64_t AbstractObject::getCountOfArray(gsoap_resqml2_0_1::resqml20__AbstractValueArray const* arrayInput) const
 {
 	if (arrayInput == nullptr) return 0;
