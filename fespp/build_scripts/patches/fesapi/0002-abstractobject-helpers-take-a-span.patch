+
+void AbstractObject::readArrayNdOfBooleanValues(gsoap_eml2_3::eml23__BooleanExternalArray const * arrayInput, COMMON_NS::Span<int8_t> arrayOutput) const
+{
+	size_t offset = 0;
+	for (auto const* dataArrayPart : arrayInput->Values->ExternalDataArrayPart) {
+		getOrCreateHdfProxyFromDataArrayPart(dataArrayPart)->readArrayNdOfInt8Values(dataArrayPart->PathInExternalFile, bufferOfPart(dataArrayPart, arrayOutput, offset));
+	}
