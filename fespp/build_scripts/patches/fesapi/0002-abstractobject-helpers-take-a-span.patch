 src/common/AbstractObject.cpp | 127 ++++++++++++++++++++++++++++++++++
 src/common/AbstractObject.h   |  69 ++++++++++++++++++
 2 files changed, 196 insertions(+)

diff --git a/src/common/AbstractObject.cpp b/src/common/AbstractObject.cpp
index aee63bd..02f7281 100644
--- a/src/common/AbstractObject.cpp
+++ b/src/common/AbstractObject.cpp
@@ -1387,6 +1387,133 @@ template<> uint64_t AbstractObject::readArrayNdOfIntegerValues(gsoap_eml2_3::eml
 	}
 }
 
+namespace {
+	/**
+	 * The part of the buffer an external data array part fills: its values counted from the XML,
+	 * taken at the running offset, which moves past them.
+	 * @exception std::range_error When the part holds more values than the buffer has left.
+	 */
+	template <typename T>
+	COMMON_NS::Span<T> bufferOfPart(gsoap_eml2_3::eml23__ExternalDataArrayPart const* dataArrayPart, COMMON_NS::Span<T> buffer, size_t& offset)
+	{
+		const uint64_t count = std::accumulate(std::begin(dataArrayPart->Count), std::end(dataArrayPart->Count), static_cast<LONG64>(1), std::multiplies<LONG64>());
+		if (count > buffer.size() - offset) {
+			throw range_error("The external data array part " + dataArrayPart->PathInExternalFile + " holds " + std::to_string(count)
+				+ " values but the buffer receiving them has " + std::to_string(buffer.size() - offset) + " left.");
+		}
+		const COMMON_NS::Span<T> part = buffer.subspan(offset, static_cast<size_t>(count));
+		offset += static_cast<size_t>(count);
+		return part;
+	}
+}
+
+void AbstractObject::readArrayNdOfFloatValues(gsoap_resqml2_0_1::resqml20__AbstractDoubleArray const* arrayInput, COMMON_NS::Span<float> arrayOutput) const
+{
+	if (arrayInput->soap_type() == SOAP_TYPE_gsoap_resqml2_0_1_resqml20__DoubleHdf5Array) {
+		gsoap_resqml2_0_1::eml20__Hdf5Dataset const* dataset = static_cast<gsoap_resqml2_0_1::resqml20__DoubleHdf5Array const*>(arrayInput)->Values;
+		getHdfProxyFromDataset(dataset)->readArrayNdOfFloatValues(dataset->PathInHdfFile, arrayOutput);
+	}
+	else {
+		// the values and their count are in the XML
+		readArrayNdOfFloatValues(arrayInput, arrayOutput.data());
+	}
+}
+
+void AbstractObject::readArrayNdOfFloatValues(gsoap_eml2_3::eml23__AbstractFloatingPointArray const* arrayInput, COMMON_NS::Span<float> arrayOutput) const
+{
+	if (arrayInput->soap_type() == SOAP_TYPE_gsoap_eml2_3_eml23__FloatingPointExternalArray) {
+		size_t offset = 0;
+		for (auto const* dataArrayPart : static_cast<gsoap_eml2_3::eml23__FloatingPointExternalArray const*>(arrayInput)->Values->ExternalDataArrayPart) {
+			getOrCreateHdfProxyFromDataArrayPart(dataArrayPart)->readArrayNdOfFloatValues(dataArrayPart->PathInExternalFile, bufferOfPart(dataArrayPart, arrayOutput, offset));
+		}
+	}
+	else {
+		// the values and their count are in the XML
+		readArrayNdOfFloatValues(arrayInput, arrayOutput.data());
+	}
+}
