+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <stdexcept>
+#include <type_traits>
+#include <vector>
+
+#include "../nsDefinitions.h"
+
+namespace COMMON_NS
+{
+	/** The value meaning "up to the end" in Span::subspan, as std::span::dynamic_extent. */
+	inline constexpr std::size_t dynamic_extent = static_cast<std::size_t>(-1);
+
+	/**
+	 * @brief	A non-owning view on a contiguous buffer of values together with its size.
+	 *
+	 * This is the C++17 stand-in for std::span<T> (C++20): same constructors (pointer and count,
+	 * std::vector, std::array, C array), same accessors (data, size, size_bytes, empty, operator[],
+	 * begin, end, first, last, subspan) so that it can become an alias of std::span the day fesapi
+	 * requires C++20, without touching the call sites.
+	 *
+	 * It is the way to give a read method the size of the buffer it fills, which lets an HDF5 proxy
+	 * check the dataset extent against it and lets an ETP proxy size its request without a
+	 * preliminary metadata round trip.
+	 */
+	template<class T>
+	class Span
+	{
+	public:
+		using element_type = T;
+		using value_type = std::remove_cv_t<T>;
+		using size_type = std::size_t;
+		using difference_type = std::ptrdiff_t;
+		using pointer = T*;
+		using const_pointer = const T*;
+		using reference = T&;
+		using const_reference = const T&;
+		using iterator = T*;
+		using reverse_iterator = std::reverse_iterator<iterator>;
+
+		/** An empty view. */
+		constexpr Span() noexcept = default;
+
+		/**
+		 * A view on @p count values starting at @p data.
+		 * @param data	The first value. May be null only when @p count is zero.
+		 * @param count	The number of values the buffer holds.
+		 */
+		constexpr Span(T* data, size_type count) noexcept : data_(data), size_(count) {}
+
+		/** A view on the values between @p first (included) and @p last (excluded). */
+		constexpr Span(T* first, T* last) noexcept : data_(first), size_(static_cast<size_type>(last - first)) {}
+
+		/** A view on a whole std::vector (non const element type). */
+		template<class U, class A, class = std::enable_if_t<std::is_convertible_v<U(*)[], T(*)[]>>>
+		Span(std::vector<U, A>& v) noexcept : data_(v.data()), size_(v.size()) {}
+
+		/** A view on a whole const std::vector (const element type only). */
+		template<class U, class A, class = std::enable_if_t<std::is_convertible_v<const U(*)[], T(*)[]>>>
+		Span(const std::vector<U, A>& v) noexcept : data_(v.data()), size_(v.size()) {}
+
+		/** A view on a whole std::array. */
+		template<class U, std::size_t N, class = std::enable_if_t<std::is_convertible_v<U(*)[], T(*)[]>>>
+		constexpr Span(std::array<U, N>& a) noexcept : data_(a.data()), size_(N) {}
+
+		/** A view on a whole const std::array (const element type only). */
+		template<class U, std::size_t N, class = std::enable_if_t<std::is_convertible_v<const U(*)[], T(*)[]>>>
+		constexpr Span(const std::array<U, N>& a) noexcept : data_(a.data()), size_(N) {}
+
+		/** A view on a whole C array. */
+		template<std::size_t N>
+		constexpr Span(T (&a)[N]) noexcept : data_(a), size_(N) {}
+
+		/** Conversion from a view on non const values to a view on const values. */
+		template<class U, class = std::enable_if_t<std::is_convertible_v<U(*)[], T(*)[]>>>
+		constexpr Span(Span<U> other) noexcept : data_(other.data()), size_(other.size()) {}
+
+		constexpr Span(const Span&) noexcept = default;
+		Span& operator=(const Span&) noexcept = default;
+
+		/** The first value, null for an empty default constructed view. */
+		constexpr T* data() const noexcept { return data_; }
+		/** The number of values. */
+		constexpr size_type size() const noexcept { return size_; }
+		/** The number of bytes. */
+		constexpr size_type size_bytes() const noexcept { return size_ * sizeof(T); }
+		/** True when the view holds no value. */
+		constexpr bool empty() const noexcept { return size_ == 0; }
+
+		constexpr T& operator[](size_type index) const noexcept { return data_[index]; }
+		constexpr T& front() const noexcept { return data_[0]; }
+		constexpr T& back() const noexcept { return data_[size_ - 1]; }
+
+		constexpr iterator begin() const noexcept { return data_; }
+		constexpr iterator end() const noexcept { return data_ + size_; }
+		constexpr reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
+		constexpr reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }
+
+		/** The first @p count values. @exception std::out_of_range when the view is shorter. */
+		constexpr Span first(size_type count) const { return subspan(0, count); }
+		/** The last @p count values. @exception std::out_of_range when the view is shorter. */
+		constexpr Span last(size_type count) const { return count > size_ ? throw std::out_of_range("Span::last") : Span(data_ + (size_ - count), count); }
+
+		/**
+		 * The values from @p offset, @p count of them or all the remaining ones.
+		 * Unlike std::span::subspan, a view that would overrun this one throws instead of being undefined.
+		 * @exception std::out_of_range when @p offset or @p offset + @p count exceeds the size.
+		 */
+		constexpr Span subspan(size_type offset, size_type count = dynamic_extent) const {
+			if (offset > size_) {
+				throw std::out_of_range("Span::subspan offset");
+			}
+			if (count == dynamic_extent) {
+				return Span(data_ + offset, size_ - offset);
+			}
+			if (count > size_ - offset) {
+				throw std::out_of_range("Span::subspan count");
+			}
+			return Span(data_ + offset, count);
+		}
+
+	private:
+		T* data_ = nullptr;
+		size_type size_ = 0;
+	};
+}
