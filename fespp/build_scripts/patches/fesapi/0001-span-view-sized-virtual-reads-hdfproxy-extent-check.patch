+TEST_CASE("Span view on a buffer", "[span]")
+{
+	std::vector<double> v{ 1.0, 2.0, 3.0, 4.0 };
+	COMMON_NS::Span<double> s(v);
+	REQUIRE(s.size() == 4);
+	REQUIRE(s.size_bytes() == 4 * sizeof(double));
+	REQUIRE(s.data() == v.data());
+	REQUIRE(s[2] == 3.0);
+	REQUIRE(s.front() == 1.0);
+	REQUIRE(s.back() == 4.0);
+	REQUIRE_FALSE(s.empty());
+	REQUIRE(COMMON_NS::Span<double>().empty());
+
+	double sum = 0.0;
+	for (double x : s) {
+		sum += x;
+	}
+	REQUIRE(sum == 10.0);
+
+	// a view on non const values converts to a view on const values, not the other way round
+	COMMON_NS::Span<const double> c = s;
+	REQUIRE(c.size() == 4);
+	REQUIRE(c[3] == 4.0);
+	const std::vector<double>& cv = v;
+	COMMON_NS::Span<const double> fromConst(cv);
+	REQUIRE(fromConst.data() == v.data());
+
+	// pointer and count, C array, std::array
+	COMMON_NS::Span<double> two(v.data() + 1, 2);
+	REQUIRE(two.size() == 2);
+	REQUIRE(two[0] == 2.0);
+	double raw[3] = { 7.0, 8.0, 9.0 };
+	COMMON_NS::Span<double> fromRaw(raw);
+	REQUIRE(fromRaw.size() == 3);
+	std::array<float, 2> arr{ 1.5f, 2.5f };
+	COMMON_NS::Span<float> fromArray(arr);
+	REQUIRE(fromArray[1] == 2.5f);
+
+	// sub views, which refuse to overrun
+	REQUIRE(s.subspan(1).size() == 3);
+	REQUIRE(s.subspan(1).front() == 2.0);
+	REQUIRE(s.subspan(1, 2).size() == 2);
+	REQUIRE(s.subspan(4).empty());
+	REQUIRE(s.first(2).back() == 2.0);
+	REQUIRE(s.last(2).front() == 3.0);
+	REQUIRE_THROWS_AS(s.subspan(5), std::out_of_range);
+	REQUIRE_THROWS_AS(s.subspan(2, 3), std::out_of_range);
+	REQUIRE_THROWS_AS(s.last(5), std::out_of_range);
+
+	// writing through the view writes the buffer
+	s[0] = 42.0;
+	REQUIRE(v[0] == 42.0);
