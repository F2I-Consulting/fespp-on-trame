-		template<typename T> void readArrayNdOfValues(const std::string & datasetName, T* values)
+		/**
+		* The sized read: the caller gave the number of values it expects, so the serialized size of
+		* the answer is bounded without asking the store (10 bytes per value, the worst case of every
+		* transport type the store may choose, plus the Avro block headers). When that bound fits in
+		* one message, a single GetDataArrays is sent, without the GetDataArrayMetadata round trip;
+		* otherwise the array is big and the unsized path (metadata, then subarrays) is taken. A
+		* request the store did not answer with an array (a protocol exception) also falls back to
+		* the unsized path. The store never writes past the buffer.
+		* @exception std::range_error When the store sent more values than the buffer holds.
+		*/
+		template<typename T> void readArrayNdOfValuesSized(const std::string & datasetName, COMMON_NS::Span<T> values)
+		{
+			const size_t valueCount = values.size();
+			if (valueCount == 0) {
+				return;
+			}
+			constexpr size_t worstValueSize = 10; // arrayOfLong, zig zag encoded, worst case
+			constexpr size_t dimensionCountBound = 16; // the dimensions are not known without the metadata
+			const size_t maxAllowedDataArraySize = session_->getMaxWebSocketMessagePayloadSize()
+				- sizeof(Energistics::Etp::v12::Datatypes::MessageHeader)
+				- (dimensionCountBound * 2 + 1) * 8;
+			if (valueCount * worstValueSize + (valueCount + 1) * 8 <= maxAllowedDataArraySize) {
+				auto specializedHandler = std::make_shared<GetFullDataArrayHandlers<T>>(session_, values.data(), valueCount);
+				session_->sendWithSpecificHandlerAndBlock(
+					buildGetDataArraysMessage(datasetName),
+					specializedHandler,
+					0, 0x02);
+				if (specializedHandler->hasOverflown()) {
+					throw std::range_error("The data array " + datasetName + " holds " + std::to_string(specializedHandler->getReceivedValueCount()) + " values but the buffer receiving them holds " + std::to_string(valueCount) + ".");
+				}
+				if (specializedHandler->getReceivedValueCount() > 0) {
+					return;
+				}
+			}
+			readArrayNdOfValues(datasetName, values.data(), valueCount);
+		}
+
+		/**
+		* The unsized read: the array metadata first, then the whole array in one message when it fits,
+		* otherwise subarrays.
+		* @param valueCapacity	The number of values the buffer can hold, 0 when unknown.
+		* @exception std::range_error When the capacity is known and the store sent more values than it.
+		*/
+		template<typename T> void readArrayNdOfValues(const std::string & datasetName, T* values, size_t valueCapacity = 0)
 		{
 			// First get metadata about the data array
 			const Energistics::Etp::v12::Datatypes::DataArrayTypes::DataArrayMetadata daMetadata = getDataArrayMetadata(datasetName);
@@ -530,7 +584,7 @@ namespace ETP_NS
 				- (daMetadata.dimensions.size() * 2 + 1) * 8; // *2 because the array can contain a maximum of element count block, +1 for the length of the last block : https://avro.apache.org/docs/1.10.2/spec.html#binary_encode_complex
 
 			// Now get values of the data array
-			auto specializedHandler = std::make_shared<GetFullDataArrayHandlers<T>>(session_, values);
+			auto specializedHandler = std::make_shared<GetFullDataArrayHandlers<T>>(session_, values, valueCapacity);
 			if (wholeSize + (valueCount + 1) * 8 <= maxAllowedDataArraySize) { // There can be valueCount array block and there is the length of the last array block
 				// Get all values at once
 				session_->sendWithSpecificHandlerAndBlock(
@@ -601,6 +655,9 @@ namespace ETP_NS
 					specializedHandler,
 					0, 0x02);
 			}
+			if (specializedHandler->hasOverflown()) {
+				throw std::range_error("The data array " + datasetName + " holds " + std::to_string(specializedHandler->getReceivedValueCount()) + " values but the buffer receiving them holds " + std::to_string(valueCapacity) + ".");
+			}
 		}
 	};
 
