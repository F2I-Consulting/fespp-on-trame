+		/**
+		* The number of values the store sent so far, written or not: zero when no array came back
+		* (the store answered with a protocol exception, for example).
+		*/
+		size_t getReceivedValueCount() const { return receivedValueCount; }
+
+		/**
+		* True when the store sent values beyond the capacity of the buffer; those were not written.
+		*/
+		bool hasOverflown() const { return overflown; }
+
+		/**
+		* The number of values an ETP AnyArray carries, whatever its transport type (zero for strings).
+		*/
+		static size_t getValueCount(const Energistics::Etp::v12::Datatypes::AnyArray& data)
+		{
+			switch (data.item.idx()) {
+			case 0: return data.item.get_ArrayOfBoolean().values.size();
+			case 1: return data.item.get_ArrayOfInt().values.size();
+			case 2: return data.item.get_ArrayOfLong().values.size();
+			case 3: return data.item.get_ArrayOfFloat().values.size();
+			case 4: return data.item.get_ArrayOfDouble().values.size();
+			case 6: return data.item.get_bytes().size();
+			default: return 0;
+			}
+		}
+
 	private:
-		/** 
+		/**
 		*	The pointer must have been allocated with sufficient size and won't be deallocated by these protocol handlers.
 		*/
 		T* const values;
+		/** The number of values the buffer can hold, 0 when unknown. */
+		const size_t valueCapacity;
+		size_t receivedValueCount = 0;
+		bool overflown = false;
 		Energistics::Etp::v12::Datatypes::DataArrayTypes::DataArrayMetadata dataArrayMetadata;
 		std::map<std::string, Energistics::Etp::v12::Datatypes::DataArrayTypes::GetDataSubarraysType> dataSubarrays;
+
+		/**
+		* Copy (and convert) @p count values of a received container, from @p sourceOffset, into the
+		* buffer at @p destinationOffset, clipped to the capacity when there is one.
+		*/
+		template<class Container>
+		void copyValues(const Container& source, size_t sourceOffset, size_t count, size_t destinationOffset)
+		{
+			receivedValueCount += count;
+			if (valueCapacity != 0 && destinationOffset + count > valueCapacity) {
+				overflown = true;
+				count = destinationOffset < valueCapacity ? valueCapacity - destinationOffset : 0;
+			}
+			std::transform(
+				std::next(source.begin(), static_cast<typename Container::difference_type>(sourceOffset)), std::next(source.begin(), static_cast<typename Container::difference_type>(sourceOffset + count)),
+				values + destinationOffset,
+				[](const auto& x) { return static_cast<T>(x); }
+			);
+		}
+
+		/**
+		* Copy @p count values of a received AnyArray, from @p sourceOffset, into the buffer at @p destinationOffset.
+		* Arrays of strings cannot be converted and are ignored.
+		*/
+		void copyAnyArray(const Energistics::Etp::v12::Datatypes::AnyArray& data, size_t sourceOffset, size_t count, size_t destinationOffset)
+		{
+			switch (data.item.idx()) {
+			case 0: copyValues(data.item.get_ArrayOfBoolean().values, sourceOffset, count, destinationOffset); break;
+			case 1: copyValues(data.item.get_ArrayOfInt().values, sourceOffset, count, destinationOffset); break;
+			case 2: copyValues(data.item.get_ArrayOfLong().values, sourceOffset, count, destinationOffset); break;
+			case 3: copyValues(data.item.get_ArrayOfFloat().values, sourceOffset, count, destinationOffset); break;
+			case 4: copyValues(data.item.get_ArrayOfDouble().values, sourceOffset, count, destinationOffset); break;
+			case 6: copyValues(data.item.get_bytes(), sourceOffset, count, destinationOffset); break;
+			default: break;
+			}
+		}
 	};
 
