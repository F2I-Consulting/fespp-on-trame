+
+TEST_CASE("Sized reads of a DataArray", "[DataArray]")
+{
+	std::shared_ptr<ETP_NS::AbstractSession> session = connect();
+	const std::string dataspaceUri = putDataspace(session);
+	REQUIRE(dataspaceUri.size() > 0);
+
+	COMMON_NS::DataObjectRepository repo;
+	repo.setDefaultStandard(COMMON_NS::DataObjectRepository::EnergisticsStandard::RESQML2_0_1);
+	repo.setDefaultStandard(COMMON_NS::DataObjectRepository::EnergisticsStandard::EML2_0);
+	repo.setHdfProxyFactory(new ETP_NS::FesapiHdfProxyFactory(session.get()));
+	auto* crs = repo.createLocalDepth3dCrs("", "Testing local depth Crs",
+		.0, .0, .0, .0, gsoap_resqml2_0_1::eml20__LengthUom::m, "Only for testing purpose", gsoap_resqml2_0_1::eml20__LengthUom::m, "Only for testing purpose", false);
+	EML2_NS::AbstractHdfProxy* etpHdfProxy = repo.createHdfProxy("f31fcc59-b8c4-4fc6-a524-973569b4cca5", "", "", "", COMMON_NS::DataObjectRepository::openingMode::READ_WRITE);
+	etpHdfProxy->setUriSource(dataspaceUri);
+	repo.setDefaultHdfProxy(etpHdfProxy);
+
+	// A small point set, whose sized read fits in one message, and a big one, which does not
+	const std::string smallUuid = "0b6d0c1e-6a1f-4d7a-9a56-3d0a3f2a5b01";
+	const std::string bigUuid = "0b6d0c1e-6a1f-4d7a-9a56-3d0a3f2a5b02";
+	RESQML2_NS::PointSetRepresentation* smallRep = repo.createPointSetRepresentation(smallUuid, "Small point set");
+	smallRep->setUriSource(dataspaceUri);
+	RESQML2_NS::PointSetRepresentation* bigRep = repo.createPointSetRepresentation(bigUuid, "Big point set");
+	bigRep->setUriSource(dataspaceUri);
+	const size_t smallCount = 1000;
+	const size_t bigCount = 1000000;
+	std::vector<double> smallPoints(smallCount * 3);
+	for (size_t i = 0; i < smallPoints.size(); ++i) {
+		smallPoints[i] = static_cast<double>(i);
+	}
+	std::vector<double> bigPoints(bigCount * 3);
+	for (size_t i = 0; i < bigPoints.size(); ++i) {
+		bigPoints[i] = static_cast<double>(i);
+	}
+	std::vector<std::string> dataspaceUris{ dataspaceUri };
+	REQUIRE(session->startTransaction(dataspaceUris, false).empty());
+	smallRep->pushBackXyzGeometryPatch(smallCount, smallPoints.data(), nullptr, crs);
+	bigRep->pushBackXyzGeometryPatch(bigCount, bigPoints.data(), nullptr, crs);
+	repo.setUriSource(dataspaceUri);
+	std::map<std::string, Energistics::Etp::v12::Datatypes::Object::DataObject> dataObjects;
+	int index = 0;
+	for (auto uuid : repo.getUuids()) {
+		dataObjects[std::to_string(index++)] = ETP_NS::FesapiHelpers::buildEtpDataObjectFromEnergisticsObject(repo, uuid);
+	}
+	session->putDataObjects(dataObjects);
+	REQUIRE(session->commitTransaction().empty());
+	const std::string smallDataset = "/resqml20/" + smallUuid + "/points_patch0";
+	const std::string bigDataset = "/resqml20/" + bigUuid + "/points_patch0";
+
+	// The small array: one GetDataArrays, no metadata round trip
+	std::vector<double> received(smallCount * 3, -1.0);
+	auto t_start = std::chrono::high_resolution_clock::now();
+	etpHdfProxy->readArrayNdOfDoubleValues(smallDataset, COMMON_NS::Span<double>(received));
+	std::cout << "Sized read of " << received.size() << " values in : " << std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now() - t_start).count() << " milliseconds." << std::endl;
+	size_t mismatches = 0;
+	for (size_t i = 0; i < received.size(); ++i) {
+		if (received[i] != static_cast<double>(i)) ++mismatches;
+	}
+	REQUIRE(mismatches == 0);
+	// the generic dispatch, with a conversion of the stored type
+	std::vector<float> asFloat(smallCount * 3, -1.f);
+	etpHdfProxy->readArrayNd(smallDataset, COMMON_NS::Span<float>(asFloat));
+	REQUIRE(asFloat[0] == 0.f);
+	REQUIRE(asFloat[smallCount * 3 - 1] == static_cast<float>(smallCount * 3 - 1));
+	// a buffer too small is refused, and nothing is written past it
+	std::vector<double> tooSmall(smallCount * 3 - 1, -1.0);
+	REQUIRE_THROWS_AS(etpHdfProxy->readArrayNdOfDoubleValues(smallDataset, COMMON_NS::Span<double>(tooSmall)), std::range_error);
+	// a bigger buffer is fine, only its first values are written
+	std::vector<double> bigger(smallCount * 3 + 10, -1.0);
+	etpHdfProxy->readArrayNdOfDoubleValues(smallDataset, COMMON_NS::Span<double>(bigger));
+	REQUIRE(bigger[smallCount * 3 - 1] == static_cast<double>(smallCount * 3 - 1));
+	REQUIRE(bigger[smallCount * 3] == -1.0);
+	// an empty view reads nothing
+	etpHdfProxy->readArrayNdOfDoubleValues(smallDataset, COMMON_NS::Span<double>());
+	// the pointer form is untouched
+	std::vector<double> viaPointer(smallCount * 3, -1.0);
+	etpHdfProxy->readArrayNdOfDoubleValues(smallDataset, viaPointer.data());
+	REQUIRE(viaPointer[1] == 1.0);
+
+	// The big array: its bound exceeds a message, the metadata and the subarrays, with the capacity checked
+	std::vector<double> bigReceived(bigCount * 3, -1.0);
+	t_start = std::chrono::high_resolution_clock::now();
+	etpHdfProxy->readArrayNdOfDoubleValues(bigDataset, COMMON_NS::Span<double>(bigReceived));
+	std::cout << "Sized read of " << bigReceived.size() << " values in : " << std::chrono::duration<double, std::milli>(std::chrono::high_resolution_clock::now() - t_start).count() << " milliseconds." << std::endl;
+	mismatches = 0;
+	for (size_t i = 0; i < bigReceived.size(); ++i) {
+		if (bigReceived[i] != static_cast<double>(i)) ++mismatches;
+	}
+	REQUIRE(mismatches == 0);
+	std::vector<double> bigTooSmall(bigCount * 3 - 1, -1.0);
+	REQUIRE_THROWS_AS(etpHdfProxy->readArrayNdOfDoubleValues(bigDataset, COMMON_NS::Span<double>(bigTooSmall)), std::range_error);
+
+	deleteDataspace(session, dataspaceUri);
+	session->close();
+}
