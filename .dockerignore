LICENSE
README.md
# Private / sensitive datasets must NOT ship in the published image.
# Dockerfile does `COPY ./data /deploy/data`; this keeps data/empty.epc and
# drops everything under data/private/ (drogon, blockWellbore test EPCs, ...).
data/private
data/private/**
# Huge dev-only trees — never part of the build context (keeps the context
# small so `docker build` / `podman build` don't upload gigabytes).
_local
_local/**
doc
doc/**
**/*.tar
# Local deploy kit (image tar + scripts) — not part of the image.
deploy
deploy/**
# ...except the session pool, which the image carries (Dockerfile:
# COPY ./deploy/pool /deploy/pool, the FESPP_POOL=1 launcher)
!deploy/pool
!deploy/pool/**
# The local AI service: its own images and build context (ia/Dockerfile);
# the app's image copies nothing from it, and its models weigh gigabytes.
ia
ia/**
_archive-*
# A store address and its token helpers: local only, never in the build context.
adme.json
scripts/adme-token.*
