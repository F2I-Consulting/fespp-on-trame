      "settle": 20
    },
    {
      "op": "check",
      "title": "HOD",
      "settle": 15
    },
    {
      "op": "activate",
      "title": "HOD",
      "settle": 3
    },
    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "all_visible",
