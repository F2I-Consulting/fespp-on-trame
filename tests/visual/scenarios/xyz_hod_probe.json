    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "add_cut",
          "box": "b1",
          "subject": "x"
        },
        "view_1"
      ],
      "settle": 3
    },
    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "add_cut",
          "box": "b1",
          "subject": "y"
        },
        "view_1"
      ],
      "settle": 3
    },
    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "add_cut",
          "box": "b1",
          "subject": "z"
        },
        "view_1"
      ],
      "settle": 3
    },
    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "toggle_cut",
          "id": "c8"
        },
        "view_1"
      ],
      "settle": 3
    },
    {
      "op": "call",
      "method": "geometry_slicer",
      "args": [
        {
          "op": "toggle_cut",
          "id": "c9"
        },
        "view_1"
      ],
      "settle": 3
