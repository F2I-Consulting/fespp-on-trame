{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Horizons_Depth.epc", "settle": 20 },
    { "op": "check", "title": "HOD", "settle": 15 },
    { "op": "activate", "title": "HOD", "settle": 3 },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["card", "subjects"], "equals": ["i", "j", "x", "y", "z"] },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["subjects", 0, "kind"], "equals": "Index" },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["subjects", 4, "label"], "contains": "Elevation" },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["subjects", 2, "kind"], "equals": "Continuous" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "box_mode", "id": "b1", "mode": "slice"}, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["card", "boxes", 0, "cuts", "x"], "equals": [] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "x"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "y"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "z"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c8"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c9"}, "view_1"], "settle": 3 },
    { "op": "xyz_crop_probe", "crops": 1, "axes": [[0]], "fewer": true, "mode": "range" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "cut_cmp", "id": "c7", "cmp": "below"}, "view_1"], "settle": 3 },
    { "op": "xyz_crop_probe", "crops": 1, "axes": [[0]], "fewer": true, "mode": "range" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c8"}, "view_1"], "settle": 3 },
    { "op": "xyz_crop_probe", "crops": 2, "axes": [[0], [1]], "fewer": true, "mode": "range" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "box_mode", "id": "b1", "mode": "range"}, "view_1"], "settle": 3 },
    { "op": "xyz_crop_probe", "mode": "full" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r2", "low": 10, "high": 40}, "view_1"], "settle": 4 },
    { "op": "xyz_crop_probe", "crops": 1, "axes": [[]], "fewer": true, "mode": "range" },
    { "op": "peek", "name": "i_range" },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r2", "low": 0, "high": 100000}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "box_mode", "id": "b1", "mode": "slice"}, "view_1"], "settle": 4 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c7"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c8"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "j"}, "view_1"], "settle": 4 },
    { "op": "xyz_crop_probe", "crops": 1, "axes": [[]], "fewer": true, "mode": "range" },
    { "op": "peek", "name": "j_cut" }
  ]
}
