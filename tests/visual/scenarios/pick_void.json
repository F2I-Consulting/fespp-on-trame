{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "check", "title": "Drilled trajectory", "settle": 10 },
    { "op": "reset_camera", "settle": 3 },
    { "op": "call", "method": "toggle_tool", "args": ["pick", "view_1"], "settle": 2 },
    { "op": "call", "method": "view_pick", "args": [[3, 3, 3, 3, 1000, 700], "view_1", "surface"], "settle": 2 },
    { "op": "expect", "var": "ui_pick_info__view_1", "equals": "(no cell selected)" },
    { "op": "call", "method": "view_pick", "args": [[500, 350, 500, 350, 1000, 700], "view_1", "surface"], "settle": 4 },
    { "op": "dump", "vars": ["ui_sel_counts__view_1", "ui_pick_info__view_1"] },
    { "op": "expect", "var": "ui_sel_counts__view_1", "size_ge": 1 },
    { "op": "call", "method": "toggle_tool", "args": ["frustum", "view_1"], "settle": 2 },
    { "op": "call", "method": "view_pick", "args": [[3, 3, 3, 3, 1000, 700], "view_1", "frustum"], "settle": 2 },
    { "op": "expect", "var": "ui_pick_info__view_1", "equals": "(no cell selected)" },
    { "op": "call", "method": "view_pick", "args": [[0, 0, 1000, 700, 1000, 700], "view_1", "frustum"], "settle": 6 },
    { "op": "dump", "vars": ["ui_sel_counts__view_1"] },
    { "op": "expect", "var": "ui_sel_counts__view_1", "size_ge": 2 },
    { "op": "call", "method": "unselect_rep", "args": [{"title": "Geogrid"}, "view_1"], "settle": 4 },
    { "op": "dump", "vars": ["ui_sel_counts__view_1"] },
    { "op": "expect", "var": "ui_sel_counts__view_1", "size_ge": 1 },
    { "op": "call", "method": "highlight_rep", "args": [{"title": "Geogrid"}], "settle": 3 },
    { "op": "expect", "var": "ui_highlighted_row", "truthy": true },
    { "op": "call", "method": "unselect_rep", "args": [{"title": "Geogrid"}], "settle": 3 },
    { "op": "expect", "var": "ui_highlighted_row", "equals": "" },
    { "op": "call", "method": "toggle_tool", "args": ["slicers", "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_slicers__view_1"] },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["mode"], "equals": "full" }
  ]
}
