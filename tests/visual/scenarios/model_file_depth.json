{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/vector_props.epc", "settle": 6 },
    { "op": "check", "title": "poro", "settle": 6 },
    { "op": "call", "method": "open_time_depth", "args": [], "settle": 12 },
    { "op": "expect", "var": "ui_vdomain__view_1", "equals": "time" },
    { "op": "expect", "var": "ui_cube_tree", "key": "grid", "equals": null },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column", "at": "centre" }], "settle": 1 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "can_generate", "equals": true },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "generate" }], "settle": 10 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": true },
    { "op": "expect", "var": "ui_time_depth_law", "key": "model", "equals": "m1" },
    { "op": "expect", "var": "ui_cube_tree", "key": "grid", "truthy": true },
    { "op": "dump", "vars": ["ui_cube_tree", "visible_paths__view_1", "undrawn_paths__view_1",
                             "converted_paths__view_1", "fixed_paths__view_1"] },
    { "op": "visible_reps_probe" },
    { "op": "block_vis_probe", "limit": 8 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "peek", "name": "model_time" },
    { "op": "call", "method": "view_domain", "args": ["view_1", "depth"], "settle": 8 },
    { "op": "expect", "var": "ui_vdomain__view_1", "equals": "depth" },
    { "op": "dump", "vars": ["visible_paths__view_1", "undrawn_paths__view_1",
                             "converted_paths__view_1", "fixed_paths__view_1"] },
    { "op": "visible_reps_probe" },
    { "op": "block_vis_probe", "limit": 8 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "peek", "name": "model_depth" }
  ]
}
