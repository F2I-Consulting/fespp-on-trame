{
  "steps": [
    { "op": "etp_open", "url": "wss://admeinterop.energy.azure.com/api/reservoir-ddms-etp/v2/",
      "partition": "opendes", "dataspace": "eml:///dataspace('maap/drogon')", "settle": 40 },
    { "op": "call", "method": "open_time_depth", "args": [], "settle": 12 },
    { "op": "expect", "var": "ui_vdomain__view_1", "equals": "time" },
    { "op": "dump", "vars": ["ui_time_depth_law", "ui_cube_tree", "ui_hidden_tree_rows"] },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": false },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column" }], "settle": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "generate" }], "settle": 2 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": false },
    { "op": "expect", "var": "ui_time_depth_law", "key": "problems", "contains": "a velocity model needs a zone: enter its corners, place a TDLaw or tick an object" },
    { "op": "tree_tick", "title": "Geogrid" },
    { "op": "wait", "s": 60 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "generate" }], "settle": 14 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": true },
    { "op": "expect", "var": "ui_cube_tree", "key": "grid", "truthy": true },
    { "op": "expect", "var": "ui_cube_grid_rows", "size_ge": 1 },
    { "op": "expect", "var": "ui_open_tools_by_view", "key": "view_1", "contains": "tree_seismic" },
    { "op": "dump", "vars": ["ui_time_depth_law", "ui_cube_tree", "ui_hidden_tree_rows", "ui_loaded_rep_paths",
                             "undrawn_paths__view_1", "converted_paths__view_1", "fixed_paths__view_1"] },
    { "op": "visible_reps_probe" },
    { "op": "reset_camera", "settle": 2 },
    { "op": "peek", "name": "model_time" },
    { "op": "call", "method": "view_domain", "args": ["view_1", "depth"], "settle": 8 },
    { "op": "expect", "var": "ui_vdomain__view_1", "equals": "depth" },
    { "op": "dump", "vars": ["undrawn_paths__view_1", "converted_paths__view_1", "fixed_paths__view_1"] },
    { "op": "visible_reps_probe" },
    { "op": "expect", "var": "converted_paths__view_1", "equals": [] },
    { "op": "expect", "var": "fixed_paths__view_1", "size_ge": 1 },
    { "op": "scene_blocks_probe", "count": 0 },
    { "op": "peek", "name": "model_depth" }
  ]
}
