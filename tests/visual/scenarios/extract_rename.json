{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "call", "method": "toggle_tool", "args": ["frustum", "view_1"], "settle": 2 },
    { "op": "call", "method": "view_pick", "args": [[300, 200, 700, 500, 1000, 700], "view_1", "frustum"], "settle": 6 },
    { "op": "activate", "title": "Facies", "settle": 2 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "supports", 0, "label"], "equals": "Whole grid" },
    { "op": "call", "method": "selection_extract", "args": [{"path": {"title": "Geogrid"}, "mode": "keep"}, "view_1"], "settle": 6 },
    { "op": "expect", "var": "ui_session_rows__view_1", "key": [0, "kind"], "equals": "extract" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "supports", 1, "value"], "equals": "session://view_1/x1" },
    { "op": "stats_support_probe", "part": "session://view_1/x1", "property_title": "Facies", "expect_label": "Kept #1" },
    { "op": "call", "method": "session_row_rename", "args": [{"path": "session://view_1/x1", "name": "My block"}, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_session_rows__view_1", "key": [0, "title"], "equals": "My block" },
    { "op": "stats_support_probe", "part": "session://view_1/x1", "property_title": "Facies", "publish": false, "expect_label": "My block" },
    { "op": "dump", "vars": ["ui_legends__view_1"] },
    { "op": "expect", "var": "ui_legends__view_1", "key": ["tables", 0, "owners"], "contains": "My block" },
    { "op": "call", "method": "view_pick", "args": [[450, 300, 550, 400, 1000, 700], "view_1", "frustum"], "settle": 4 },
    { "op": "dump", "vars": ["ui_pick_info__view_1"] },
    { "op": "expect", "var": "ui_pick_info__view_1", "contains": "My block" },
    { "op": "check", "title": "Drilled trajectory", "settle": 8 },
    { "op": "activate", "title": "Drilled trajectory", "tab": "well", "settle": 2 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "assoc": "CELLS"}, "view_1"], "settle": 2 },
    { "op": "call", "method": "node_highlight", "args": [[0, 1, 2, 3, 4, 5], "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_sel_counts__view_1"] },
    { "op": "call", "method": "selection_extract", "args": [{"path": {"title": "Drilled trajectory"}, "mode": "keep"}, "view_1"], "settle": 6 },
    { "op": "dump", "vars": ["ui_session_rows__view_1", "ui_view_note__view_1"] },
    { "op": "call", "method": "session_row_rename", "args": [{"path": "session://view_1/x2", "name": "My well part"}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_session_rows__view_1", "key": [1, "title"], "equals": "My well part" },
    { "op": "activate", "title": "Facies", "settle": 3 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "part": "session://view_1/x1"}, "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_node_values_by_view"] },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "part"], "equals": "session://view_1/x1" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "supports", 1, "value"], "equals": "session://view_1/x1" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "grid cell" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "points_at"], "equals": 5 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "points"], "truthy": true },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 },
    { "op": "call", "method": "node_highlight", "args": [[0, 1, 2], "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_sel_counts__view_1"] },
    { "op": "call", "method": "node_values_csv", "args": [{"offset": 0, "part": "session://view_1/x1", "n": "csv-x1"}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_node_values_csv_by_view", "key": ["view_1", "n"], "equals": "csv-x1" },
    { "op": "expect", "var": "ui_node_values_csv_by_view", "key": ["view_1", "text"], "contains": "# read on: My block" }
  ]
}
