{
  "steps": [
    { "op": "etp_open", "url": "wss://admeinterop.energy.azure.com/api/reservoir-ddms-etp/v2/",
      "partition": "opendes", "dataspace": "eml:///dataspace('maap/drogon')", "settle": 40 },
    { "op": "load", "path": "/tmp/testdata/vector_props.epc", "settle": 12 },
    { "op": "tree_tick", "title": "Geogrid" },
    { "op": "wait", "s": 60 },
    { "op": "check", "title": "poro", "under": "unknown", "settle": 10 },
    { "op": "expect", "var": "ui_loaded_rep_paths", "size_ge": 2 },
    { "op": "call", "method": "etp_disconnect", "settle": 5 },
    { "op": "expect", "var": "etp_connected", "equals": false },
    { "op": "load", "path": "/tmp/testdata/velocity_lattice.epc", "settle": 12 },
    { "op": "expect", "var": "assembly_xml", "contains": "Geogrid" },
    { "op": "expect", "var": "assembly_xml", "contains": "_gridfolder_7de0f0a1-2cfa-481d-988f-b42a24aa32cd" },
    { "op": "expect", "var": "ui_loaded_rep_paths", "size_ge": 2 },
    { "op": "expect", "var": "ui_cube_grid_rows", "size_ge": 1 },
    { "op": "dump", "vars": ["ui_loaded_rep_paths", "selected_paths", "visible_paths__view_1"] },
    { "op": "visible_reps_probe" },
    { "op": "block_vis_probe", "limit": 6 },
    { "op": "scene_blocks_probe", "drawn": true },
    { "op": "tree_tick", "title": "TopTherys" },
    { "op": "wait", "s": 6 },
    { "op": "expect", "var": "empty_color_snackbar_text", "contains": "Disconnected from the OSDU server" },
    { "op": "expect", "var": "ui_load_progress", "key": "running", "equals": false },
    { "op": "dump", "vars": ["ui_loaded_rep_paths", "selected_paths", "ui_load_progress"] },
    { "op": "scene_blocks_probe", "drawn": true },
    { "op": "uncheck", "title": "Geogrid", "settle": 10 },
    { "op": "check", "title": "Geogrid", "settle": 6 },
    { "op": "expect", "var": "empty_color_snackbar_text", "contains": "Disconnected from the OSDU server" },
    { "op": "scene_blocks_probe", "drawn": true }
  ]
}
