{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Horizons_Depth.epc", "settle": 10 },
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Fault_Horizon_TIME.epc", "settle": 10 },
    { "op": "expect", "var": "ui_vdomains", "equals": ["depth", "time"] },
    { "op": "check", "title": "HOD", "settle": 8 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "visible_reps_probe" },
    { "op": "peek", "name": "1_hod_depth" },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": false },
    { "op": "tree_tick", "title": "Volve_F5_2011" },
    { "op": "wait", "s": 6 },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": "No active velocity model" },
    { "op": "expect", "var": "converted_paths__{vid}", "equals": [] },
    { "op": "call", "method": "tick_confirm_answer", "args": [false], "settle": 2 },
    { "op": "expect", "var": "undrawn_paths__{vid}", "size_ge": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column", "at": "centre" }], "settle": 1 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "can_generate", "equals": true },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "generate" }], "settle": 10 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": true },
    { "op": "expect", "var": "ui_time_depth_law", "key": "model", "equals": "m1" },
    { "op": "expect", "var": "converted_paths__{vid}", "size_ge": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add", "depth": 3000, "twt": 2400 }], "settle": 2 },
    { "op": "dump", "vars": ["ui_time_depth_law"] },
    { "op": "tree_tick", "title": "Volve_F6_2011" },
    { "op": "wait", "s": 6 },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": null },
    { "op": "expect", "var": "converted_paths__{vid}", "size_ge": 2 },
    { "op": "visible_reps_probe" },
    { "op": "scene_blocks_probe" },
    { "op": "peek", "name": "2_f6_converted" },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "set", "index": 1, "twt": 1200 }], "settle": 4 },
    { "op": "visible_reps_probe" },
    { "op": "peek", "name": "3_law_changed" },
    { "op": "call", "method": "view_domain", "args": ["view_1", "time"], "settle": 5 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "visible_reps_probe" },
    { "op": "scene_blocks_probe" },
    { "op": "peek", "name": "4_time_view" },
    { "op": "call", "method": "view_domain", "args": ["view_1", "depth"], "settle": 5 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column", "x": 436000, "y": 6473000 }], "settle": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column", "x": 440000, "y": 6478000 }], "settle": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "set", "index": 1, "twt": 1800 }], "settle": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add", "depth": 4000, "twt": 2300 }], "settle": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "cube_set", "nx": 8, "ny": 8 }], "settle": 3 },
    { "op": "dump", "vars": ["ui_time_depth_law"] },
    { "op": "call", "method": "open_time_depth", "args": [], "settle": 12 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "dump", "vars": ["ui_cube_tree", "visible_paths__view_1"] },
    { "op": "expect", "var": "ui_cube_tree", "key": "grid", "truthy": true },
    { "op": "visible_reps_probe" },
    { "op": "reset_camera", "settle": 1 },
    { "op": "camera", "elevation": -55, "azimuth": 30, "settle": 2 },
    { "op": "peek", "name": "5_model_in_time" },
    { "op": "render_timing", "label": "Volve: a time polyline converted into the depth view, the velocity model drawn", "frames": 1 }
  ]
}
