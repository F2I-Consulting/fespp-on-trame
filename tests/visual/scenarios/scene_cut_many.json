{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "tree_tick_all", "type": "Trajectory" },
    { "op": "wait", "s": 15 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "render_timing", "label": "drogon grid and 12 trajectories", "frames": 3 },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 3 },
    { "op": "card_narrow", "card": "ui_geometry_card__view_1", "method": "geometry_slicer", "box": 0, "fraction": 0.6 },
    { "op": "render_timing", "label": "many objects, one box narrowed on its 3 axes", "frames": 5 },
    { "op": "scene_cut_step_timing", "steps": 3 },
    { "op": "profile_call", "method": "geometry_slicer", "args": [{"op": "player", "id": "r2", "action": "step", "value": 30}, "view_1"], "top": 25, "settle": 1 },
    { "op": "profile_call", "method": "geometry_slicer", "args": [{"op": "player", "id": "r2", "action": "step", "value": 31}, "view_1"], "top": 25, "settle": 1 },
    { "op": "scene_crop_probe", "pieces": 1 }
  ]
}
