{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 10 },
    { "op": "activate", "title": "Facies", "settle": 3 },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_geometry_card__view_1"] },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["card", "boxes", 0, "id"], "equals": "b1" },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["fixed"], "equals": true },
    { "op": "profile_call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r2", "low": 10, "high": 20}, "view_1"], "top": 20, "settle": 4 },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["volumes", 0, 0], "equals": [10, 20] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_range", "box": "b1", "subject": "i", "join": "or"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r5", "low": 30, "high": 40}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["volumes", 1, 0], "equals": [30, 40] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "join_range", "id": "r5", "join": "and"}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["volumes"], "equals": [] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "del_box", "id": "b1"}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["card", "boxes"], "equals": [] },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["mode"], "equals": "full" },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_box", "mode": "slice"}, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["mode"], "equals": "full" },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "i"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "j"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "k"}, "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_geometry_card__view_1", "ui_slicers__view_1"] },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["mode"], "equals": "range" },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "player", "id": "c5", "action": "play", "value": true}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_geometry_player__view_1", "key": ["playing"], "equals": true },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "player", "id": "c5", "action": "play", "value": false}, "view_1"], "settle": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c6"}, "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_slicers__view_1"] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "toggle_cut", "id": "c6"}, "view_1"], "settle": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "cut_cmp", "id": "c5", "cmp": "above"}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_geometry_card__view_1", "key": ["card", "boxes", 0, "cuts", "i", 0, "cmp"], "equals": "above" },
    { "op": "expect", "var": "ui_geometry_player__view_1", "key": ["playing"], "equals": false },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": false}, "view_1"], "settle": 3 },
    { "op": "expect", "var": "ui_slicers__view_1", "key": ["mode"], "equals": "full" },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 3 },
    { "op": "isolate_probe" },

    { "op": "call", "method": "property_slicer", "args": [{"op": "add_subject", "subject": "Facies"}, "view_1"], "settle": 6 },
    { "op": "dump", "vars": ["ui_property_card__view_1", "ui_thresholds__view_1"] },
    { "op": "expect", "var": "ui_property_card__view_1", "key": ["card", "subjects"], "equals": ["Facies"] },
    { "op": "expect", "var": "ui_property_card__view_1", "key": ["subjects", 0, "kind"], "equals": "Discrete" },
    { "op": "call", "method": "property_slicer", "args": [{"op": "box_mode", "id": "b1", "mode": "slice"}, "view_1"], "settle": 4 },
    { "op": "call", "method": "property_slicer", "args": [{"op": "add_cut", "box": "b1", "subject": "Facies"}, "view_1"], "settle": 4 },
    { "op": "dump", "vars": ["ui_property_card__view_1", "ui_thresholds__view_1"] },
    { "op": "call", "method": "property_slicer", "args": [{"op": "player", "id": "c3", "action": "play", "value": true}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_property_player__view_1", "key": ["playing"], "equals": true },
    { "op": "expect", "var": "ui_property_player__view_1", "key": ["count"], "equals": 8 },
    { "op": "call", "method": "property_slicer", "args": [{"op": "player", "id": "c3", "action": "play", "value": false}, "view_1"], "settle": 1 },
    { "op": "call", "method": "property_slicer", "args": [{"op": "cut_cmp", "id": "c3", "cmp": "below"}, "view_1"], "settle": 3 },
    { "op": "dump", "vars": ["ui_thresholds__view_1"] },
    { "op": "expect", "var": "ui_thresholds__view_1", "key": [0, "low"], "equals": 0.0 },
    { "op": "isolate_probe" }
  ]
}
