{
  "steps": [
    { "op": "etp_open", "url": "wss://admeinterop.energy.azure.com/api/reservoir-ddms-etp/v2/",
      "partition": "opendes", "dataspace": "eml:///dataspace('maap/drogon')", "settle": 40 },
    { "op": "expect", "var": "assembly_xml", "contains": "Geogrid" },
    { "op": "load", "path": "/tmp/testdata/testingPackageCpp_blockWellbore.epc", "settle": 12 },
    { "op": "expect", "var": "assembly_xml", "contains": "Geogrid" },
    { "op": "expect", "var": "assembly_xml", "contains": "_gridfolder_0c49b40a-632a-457a-b519-a178f40a397d" },
    { "op": "tree_tick", "title": "Geogrid" },
    { "op": "wait", "s": 60 },
    { "op": "tree_tick", "title": "TopTherys" },
    { "op": "wait", "s": 20 },
    { "op": "expect", "var": "ui_loaded_rep_paths", "size_ge": 2 },
    { "op": "scene_blocks_probe", "drawn": true },
    { "op": "reset_camera", "settle": 2 },
    { "op": "bounds_probe", "limit": 8 },
    { "op": "shot", "name": "store_objects" },
    { "op": "tree_tick", "title": "Horizon1 Interp1 TriRep" },
    { "op": "wait", "s": 8 },
    { "op": "tree_tick", "title": "Fault1 Interp1 TriRep" },
    { "op": "wait", "s": 8 },
    { "op": "dump", "vars": ["ui_loaded_rep_paths", "selected_paths", "visible_paths__view_1", "ui_tick_confirm"] },
    { "op": "expect", "var": "ui_loaded_rep_paths", "size_ge": 4 },
    { "op": "visible_reps_probe" },
    { "op": "block_vis_probe", "limit": 6 },
    { "op": "scene_blocks_probe", "drawn": true },
    { "op": "uncheck", "title": "Geogrid", "settle": 6 },
    { "op": "uncheck", "title": "TopTherys", "settle": 6 },
    { "op": "scene_blocks_probe", "drawn": true },
    { "op": "reset_camera", "settle": 2 },
    { "op": "bounds_probe", "limit": 8 },
    { "op": "shot", "name": "file_objects" },
    { "op": "load", "path": "/tmp/testdata/velocity_lattice.epc", "settle": 12 },
    { "op": "dump", "vars": ["ui_cube_grid_rows", "ui_compare_tree_families"] },
    { "op": "expect", "var": "ui_cube_grid_rows", "size_ge": 1 }
  ]
}
