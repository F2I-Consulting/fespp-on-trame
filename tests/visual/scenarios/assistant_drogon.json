{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "call", "method": "open_assistant", "args": [], "settle": 2 },
    { "op": "assistant_probe", "say": "montre la porosité de Geogrid",
      "expect_intent": "show", "expect_level": "ok", "expect_panel": "assistant",
      "expect_visible": [{ "title": "Total Porosity", "under": "Geogrid" }],
      "expect_wait": 60, "settle": 6 },
    { "op": "assistant_probe", "say": "filtre la porosité au-dessus de 0,2",
      "expect_intent": "threshold", "expect_level": "ok",
      "expect_threshold": true, "then_undo": true, "settle": 4 },
    { "op": "assistant_probe", "say": "quelle est la porosité moyenne ?",
      "expect_intent": "value", "expect_level": "ok",
      "expect_row": ["Mean", "Moyenne"], "settle": 2 },
    { "op": "assistant_probe", "say": "exagération verticale x 3",
      "expect_intent": "z_scale", "expect_level": "ok",
      "expect_state": { "ui_scale_z__view_1": 3 }, "settle": 3 },
    { "op": "assistant_probe", "say": "ouvre les statistiques",
      "expect_intent": "open_panel", "expect_level": "ok",
      "expect_panel": "compare", "settle": 4 },
    { "op": "assistant_probe", "say": "décris Geogrid",
      "expect_intent": "describe", "expect_level": "ok", "settle": 2 },
    { "op": "assistant_probe", "say": "liste ce qui est chargé",
      "expect_intent": "list", "expect_level": "ok", "settle": 2 },
    { "op": "assistant_probe", "say": "surligne les mailles où la porosité dépasse 0,2",
      "expect_intent": "highlight", "expect_level": "ok",
      "expect_text_matches": "^[1-9][0-9\\u2009\\u202f\\u00a0 ]* of [0-9\\u2009\\u202f\\u00a0 ]+ cells? highlighted: ",
      "expect_highlight_count_min": 1, "settle": 3 },
    { "op": "assistant_probe", "say": "enlève la surbrillance",
      "expect_intent": "clear_highlight", "expect_level": "ok",
      "expect_highlight_cleared": true, "settle": 2 },
    { "op": "assistant_probe", "say": "surligne les mailles traversées par les puits",
      "expect_intent": "well_cells", "expect_level": "ok",
      "expect_text_contains": "Cells the wells go through: ",
      "expect_highlight_count_min": 1, "expect_wait": 60, "settle": 4 },
    { "op": "assistant_probe", "say": "quels puits traversent les mailles où la porosité dépasse 0,2 ?",
      "expect_intent": "well_cells", "expect_level": "ok",
      "expect_text_matches": "(well crosses|wells cross) Total Porosity ≥ 0.2: ",
      "expect_highlight_count_min": 1, "expect_wait": 60, "settle": 4 },
    { "op": "assistant_probe", "say": "enlève les puits qui ne traversent pas les mailles où la porosité dépasse 0,35",
      "expect_intent": "well_cells", "expect_level": "ok",
      "expect_text_matches": "wells? hidden: |No well to hide",
      "then_undo": true, "expect_wait": 60, "settle": 4 },
    { "op": "assistant_probe", "say": "enlève la surbrillance",
      "expect_intent": "clear_highlight", "expect_level": "ok",
      "expect_highlight_cleared": true, "settle": 2 },
    { "op": "assistant_probe", "say": "blablabla xyz",
      "expect_level": "error", "settle": 1 }
  ]
}
