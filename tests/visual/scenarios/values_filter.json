{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "activate", "title": "Geogrid", "settle": 3 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "CELLS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns", 0], "equals": "cell id" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filter_columns"], "contains": "K" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filter_columns"], "contains": "Facies" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "points_at"], "equals": 4 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filter_range"], "size_ge": 2 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "filter": "K"}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filter_on"], "equals": "K" },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "filters": [{"column": "I", "min": 10, "max": 20}, {"column": "J", "min": 5, "max": 6, "op": "and"}]}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filters", 1, "column"], "equals": "J" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "ranges", "J"], "size_ge": 2 },
    { "op": "dump", "vars": ["ui_node_values_by_view"] },
    { "op": "call", "method": "node_values_csv", "args": [{"offset": 0, "filter": "K", "min": 2, "max": 3, "n": "csv-1"}, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_node_values_csv_by_view", "key": ["view_1", "n"], "equals": "csv-1" },
    { "op": "expect", "var": "ui_node_values_csv_by_view", "key": ["view_1"], "missing": "error" },
    { "op": "expect", "var": "ui_node_values_csv_by_view", "key": ["view_1", "name"], "contains": "values_" },
    { "op": "activate", "title": "Facies", "settle": 3 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "Facies" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "K" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "supports", 0, "label"], "equals": "Whole grid" },
    { "op": "dump", "vars": ["ui_node_values_by_view"] },
    { "op": "check", "title": "Depth Points (Interpreted)", "settle": 8 },
    { "op": "activate", "title": "Depth Points (Interpreted)", "settle": 3 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "POINTS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns", 0], "equals": "point id" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "filter_columns"], "contains": "Elevation" },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "assoc": "CELLS"}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "CELLS" },
    { "op": "check", "title": "Depth Surface - Interpreted", "settle": 8 },
    { "op": "activate", "title": "Depth Surface - Interpreted", "settle": 2 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1"], "missing": "error" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "CELLS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "assoc": "POINTS"}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 }
  ]
}
