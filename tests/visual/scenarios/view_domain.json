{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Fault_Horizon_TIME.epc", "settle": 20 },
    { "op": "expect", "var": "assembly_xml", "contains": "vdomain=\"time\"" },
    { "op": "expect", "var": "ui_vdomains", "equals": ["time"] },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Horizons_Depth.epc", "settle": 20 },
    { "op": "expect", "var": "ui_vdomains", "equals": ["depth", "time"] },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "tree_tick", "title": "BCU_ts" },
    { "op": "wait", "s": 15 },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": null },
    { "op": "expect", "var": "converted_paths__{vid}", "equals": [] },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "expect", "var": "undrawn_paths__{vid}", "equals": [] },
    { "op": "scene_blocks_probe", "label": "the first object, in time, drawn in a view turned to time", "count": 1 },
    { "op": "tree_tick", "title": "HOD" },
    { "op": "wait", "s": 12 },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": "View in time" },
    { "op": "expect", "var": "ui_tick_confirm", "key": "ok", "equals": "Switch the view to depth" },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "call", "method": "tick_confirm_answer", "args": [false], "settle": 2 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "expect", "var": "undrawn_paths__{vid}", "size_ge": 1 },
    { "op": "call", "method": "view_domain", "args": ["view_1", "depth"], "settle": 4 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": null },
    { "op": "expect", "var": "undrawn_paths__{vid}", "size_ge": 1 },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "add_column", "at": "centre" }], "settle": 1 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "can_generate", "equals": true },
    { "op": "call", "method": "time_depth_law_edit", "args": [{ "op": "generate" }], "settle": 10 },
    { "op": "expect", "var": "ui_time_depth_law", "key": "generated", "equals": true },
    { "op": "expect", "var": "ui_time_depth_law", "key": "model", "equals": "m1" },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "expect", "var": "converted_paths__{vid}", "size_ge": 1 },
    { "op": "dump", "vars": ["converted_paths__view_1", "undrawn_paths__view_1", "fixed_paths__view_1", "ui_view_note__view_1"] },
    { "op": "block_vis_probe", "limit": 4, "of_source": true },
    { "op": "axes_labels_probe", "expect": ["E (m)", "N (m)", "Z (m)"] },
    { "op": "expect", "var": "ui_tick_confirm", "key": "title", "equals": null },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "block_vis_probe", "limit": 4 },
    { "op": "call", "method": "view_domain", "args": ["view_1", "time"] },
    { "op": "wait", "s": 4 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "time" },
    { "op": "dump", "vars": ["converted_paths__view_1", "undrawn_paths__view_1", "fixed_paths__view_1", "ui_view_note__view_1"] },
    { "op": "block_vis_probe", "limit": 4 },
    { "op": "axes_labels_probe", "expect": ["E (m)", "N (m)", "T (ms)"] },
    { "op": "call", "method": "view_domain", "args": ["view_1", "depth"] },
    { "op": "wait", "s": 4 },
    { "op": "expect", "var": "ui_vdomain__{vid}", "equals": "depth" },
    { "op": "dump", "vars": ["converted_paths__view_1", "undrawn_paths__view_1", "fixed_paths__view_1", "ui_view_note__view_1"] },
    { "op": "axes_labels_probe", "expect": ["E (m)", "N (m)", "Z (m)"] },
    { "op": "tree_tick", "title": "Volve_F11_2011_SnS_bad_points" },
    { "op": "wait", "s": 15 },
    { "op": "block_vis_probe", "limit": 6 },
    { "op": "dump", "vars": ["converted_paths__view_1", "undrawn_paths__view_1", "fixed_paths__view_1", "ui_view_note__view_1"] }
  ]
}
