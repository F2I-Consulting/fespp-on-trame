{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 25 },
    { "op": "call", "method": "add_to_welllog",
      "args": [{ "title": "Well Log Frame", "under": "55/33-A-2" }], "settle": 30 },
    { "op": "call", "method": "values_focus",
      "args": ["welllog", { "title": "Well Log Frame", "under": "55/33-A-2" }], "settle": 2 },
    { "op": "call", "method": "node_values", "args": [{ "offset": 0, "hide_nan": false }, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "POINTS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "total"], "equals": 4865 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "MD" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "HorizontalPermeabilityOriginalLog" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "columns"], "contains": "AcousticImpedanceEdited" },
    { "op": "call", "method": "node_values", "args": [{ "offset": 0, "assoc": "CELLS", "hide_nan": true }, "view_1"], "settle": 4 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "CELLS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "equals": 21 },
    { "op": "dump", "vars": ["ui_node_values_by_view"] }
  ]
}
