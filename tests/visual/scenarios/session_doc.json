{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "call", "method": "session_apply_doc", "args": [{"session": {"selected_paths": [{"title": "Facies"}]}, "views": [{"kind": "render", "eyes": [{"title": "Facies"}]}]}], "settle": 12 },
    { "op": "dump", "vars": ["ui_session_status"] },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "done" },
    { "op": "expect", "var": "ui_loaded_array_paths", "size_ge": 1 },
    { "op": "expect", "var": "visible_paths__view_1", "size_ge": 1 },
    { "op": "call", "method": "session_state", "args": [], "settle": 2 },
    { "op": "expect", "var": "ui_session_state", "key": ["schema"], "equals": 1 },
    { "op": "expect", "var": "ui_session_state", "key": ["session", "selected_paths"], "size_ge": 1 },
    { "op": "expect", "var": "ui_session_state", "key": ["views"], "size_ge": 1 },
    { "op": "call", "method": "session_apply_doc", "args": [{"views": []}], "settle": 3 },
    { "op": "expect", "var": "visible_paths__view_1", "equals": [] },
    { "op": "expect", "var": "ui_loaded_array_paths", "size_ge": 1 },
    { "op": "call", "method": "session_apply_doc", "args": [{"views": [{"kind": "render", "eyes": [{"title": "Facies"}]}]}], "settle": 4 },
    { "op": "expect", "var": "visible_paths__view_1", "size_ge": 1 },
    { "op": "call", "method": "session_apply_doc", "args": [{"views": [{"kind": "render"}, {"kind": "stats", "place": "right", "pinned": [{"title": "Facies"}]}]}], "settle": 4 },
    { "op": "dump", "vars": ["ui_session_status"] },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "done" },
    { "op": "expect", "var": "ui_compare_items", "size_ge": 1 },
    { "op": "call", "method": "session_state", "args": [], "settle": 2 },
    { "op": "expect", "var": "ui_session_state", "key": ["views"], "size_ge": 2 },
    { "op": "call", "method": "session_apply_doc", "args": [{"views": [{"kind": "render"}, {"kind": "compare", "place": "right", "items": [{"path": {"title": "Facies"}}]}]}], "settle": 4 },
    { "op": "dump", "vars": ["ui_session_status"] },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "done" },
    { "op": "expect", "var": "ui_compare_items", "key": [0, "uid"], "truthy": true },
    { "op": "call", "method": "session_apply_doc", "args": [{"views": [{"kind": "stats", "place": "sideways"}]}], "settle": 2 },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "error" },
    { "op": "expect", "var": "ui_session_status", "key": ["error"], "contains": "right or below" },
    { "op": "call", "method": "session_apply_doc", "args": [{"reset": true}], "settle": 6 },
    { "op": "dump", "vars": ["ui_session_status", "ui_loaded_rep_paths"] },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "done" },
    { "op": "expect", "var": "ui_loaded_rep_paths", "equals": [] },
    { "op": "call", "method": "session_apply_doc", "args": ["{\"views\": {}}"], "settle": 2 },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "error" },
    { "op": "expect", "var": "ui_session_status", "key": ["error"], "contains": "views is not a list" },
    { "op": "call", "method": "session_apply_doc", "args": [{"session": {"selected_paths": ["uuid:00000000-0000-0000-0000-000000000000"]}}], "settle": 3 },
    { "op": "dump", "vars": ["ui_session_status"] },
    { "op": "expect", "var": "ui_session_status", "key": ["phase"], "equals": "done" }
  ]
}
