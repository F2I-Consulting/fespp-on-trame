{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Depth Points (Interpreted)", "settle": 8 },
    { "op": "reset_camera", "settle": 3 },
    { "op": "activate", "title": "Depth Points (Interpreted)", "settle": 2 },
    { "op": "call", "method": "toggle_tool", "args": ["frustum", "view_1"], "settle": 2 },
    { "op": "call", "method": "view_pick", "args": [[400, 250, 600, 450, 1000, 700], "view_1", "frustum"], "settle": 4 },
    { "op": "dump", "vars": ["ui_pick_info__view_1", "ui_sel_counts__view_1"] },
    { "op": "expect", "var": "ui_pick_info__view_1", "contains": "points" },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "only": true}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "assoc"], "equals": "POINTS" },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "lt": 25000 },
    { "op": "call", "method": "toggle_tool", "args": ["frustum", "view_1"], "settle": 1 },
    { "op": "call", "method": "toggle_tool", "args": ["pick", "view_1"], "settle": 2 },
    { "op": "call", "method": "view_pick", "args": [[400, 250, 600, 450, 1000, 700], "view_1", "surface"], "settle": 4 },
    { "op": "dump", "vars": ["ui_pick_info__view_1", "ui_sel_counts__view_1"] },
    { "op": "expect", "var": "ui_pick_info__view_1", "contains": "points" },
    { "op": "call", "method": "node_values", "args": [{"offset": 0, "only": true}, "view_1"], "settle": 2 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "gt": 0 },
    { "op": "expect", "var": "ui_node_values_by_view", "key": ["view_1", "count"], "lt": 25000 },
    { "op": "call", "method": "selection_extract", "args": [{"path": {"title": "Depth Points (Interpreted)"}, "mode": "keep"}, "view_1"], "settle": 6 },
    { "op": "dump", "vars": ["ui_view_note__view_1"] },
    { "op": "expect", "var": "ui_view_note__view_1", "contains": "points" },
    { "op": "call", "method": "session_row_rename", "args": [{"path": "session://view_1/x1", "name": "  Picked   points "}, "view_1"], "settle": 1 },
    { "op": "expect", "var": "ui_session_rows__view_1", "key": [0, "title"], "equals": "Picked points" },
    { "op": "expect", "var": "ui_session_rows__view_1", "key": [0, "kind"], "equals": "extract" },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "reset_camera", "settle": 3 },
    { "op": "call", "method": "view_pick", "args": [[0, 0, 1000, 700, 1000, 700], "view_1", "surface"], "settle": 6 },
    { "op": "dump", "vars": ["ui_pick_info__view_1", "ui_sel_counts__view_1"] },
    { "op": "expect", "var": "ui_sel_counts__view_1", "size_ge": 1 }
  ]
}
