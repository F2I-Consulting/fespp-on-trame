    { "op": "load", "path": "/tmp/testdata/olympus/OlympusOnlyProp.epc", "settle": 10 },
    { "op": "load", "path": "/tmp/testdata/olympus/OlympusGridAndProp.epc", "settle": 10 },
    { "op": "load", "path": "/tmp/testdata/olympus/OlympusWell.epc", "settle": 20 },
    { "op": "dump", "vars": ["ui_hidden_tree_rows", "visible_paths__view_1", "visible_paths__view_3", "visible_paths__view_2"] },
    { "op": "expect", "var": "ui_cube_tree", "key": "grid", "truthy": true },
    { "op": "expect", "var": "ui_hidden_tree_rows", "size_ge": 1 }
  ]
