{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "activate", "title": "Geogrid", "settle": 3 },
    { "op": "camera", "elevation": -55, "azimuth": 25, "settle": 2 },
    { "op": "shot", "name": "full" },
    { "op": "call", "method": "slicer_mode", "args": ["slice", "view_1"], "settle": 6 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "slice_mid" },
    { "op": "eye", "title": "Facies", "settle": 4 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "slice_eye_closed" },
    { "op": "eye", "title": "Facies", "settle": 4 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "slice_eye_reopened" },
    { "op": "call", "method": "slicer_mode", "args": ["range", "view_1"], "settle": 4 },
    { "op": "call", "method": "slicer_volumes", "args": [[[[0, 92], [0, 146], [0, 3]]], "view_1"], "settle": 6 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "range_crop" },
    { "op": "call", "method": "slicer_volumes", "args": [[[[0, 92], [0, 146], [0, 3]], [[0, 30], [0, 40], [0, 69]]], "view_1"], "settle": 6 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "two_volumes_union" },
    { "op": "call", "method": "slicer_volumes_visible", "args": [[false, true], "view_1"], "settle": 3 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "first_volume_hidden" },
    { "op": "call", "method": "slicer_volumes", "args": [[], "view_1"], "settle": 4 },
    { "op": "slicer_probe" },
    { "op": "dump", "vars": ["ui_slicers__view_1"] },
    { "op": "shot", "name": "no_volume" },
    { "op": "call", "method": "slicer_volumes", "args": [[[[0, 92], [0, 146], [0, 3]], [[0, 30], [0, 40], [0, 69]]], "view_1"], "settle": 5 },
    { "op": "call", "method": "slicer_volumes_visible", "args": [[false, true], "view_1"], "settle": 3 },
    { "op": "call", "method": "slicer_mode", "args": ["full", "view_1"], "settle": 5 },
    { "op": "dump", "vars": ["ui_slicers__view_1"] },
    { "op": "shot", "name": "full_again" },
    { "op": "call", "method": "slicer_mode", "args": ["range", "view_1"], "settle": 5 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "range_state_kept" },
    { "op": "call", "method": "slicer_mode", "args": ["full", "view_1"], "settle": 4 },
    { "op": "shot", "name": "full_last" }
  ]
}
