{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/drogon.epc", "settle": 8 },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "activate", "title": "Facies", "settle": 2 },
    { "op": "dump", "vars": ["ui_color_arrays_by_view", "ui_thresholds_note__view_1"] },
    { "op": "call", "method": "threshold_add", "args": ["Facies", "view_1"], "settle": 6 },
    { "op": "dump", "vars": ["ui_thresholds__view_1"] },
    { "op": "shot", "name": "thresholded" },
    { "op": "call", "method": "threshold_add", "args": [["Facies", null], "view_1"], "settle": 4 },
    { "op": "slicer_probe" },
    { "op": "shot", "name": "union_second_root" },
    { "op": "call", "method": "threshold_add", "args": [["Facies", { "chain_entry": 0 }], "view_1"], "settle": 4 },
    { "op": "slicer_probe" },
    { "op": "dump", "vars": ["ui_thresholds__view_1"] },
    { "op": "shot", "name": "intersection_under_first" },
    { "op": "call", "method": "threshold_remove", "args": [{ "chain_entry": 2 }, "view_1"], "settle": 3 },
    { "op": "call", "method": "threshold_remove", "args": [{ "chain_entry": 1 }, "view_1"], "settle": 3 },
    { "op": "slicer_probe" },
    { "op": "uncheck", "title": "Facies", "settle": 6 },
    { "op": "dump", "vars": ["selected_paths", "ui_thresholds__view_1", "empty_color_snackbar_text"] },
    { "op": "shot", "name": "property_unchecked_under_threshold" },
    { "op": "uncheck", "title": "SolidColor", "under": "Geogrid", "settle": 8 },
    { "op": "dump", "vars": ["selected_paths", "ui_thresholds__view_1", "ui_slicers__view_1"] },
    { "op": "shot", "name": "grid_unloaded_under_threshold" },
    { "op": "check", "title": "Facies", "settle": 12 },
    { "op": "dump", "vars": ["selected_paths", "ui_thresholds__view_1"] },
    { "op": "shot", "name": "grid_reloaded" }
  ]
}
