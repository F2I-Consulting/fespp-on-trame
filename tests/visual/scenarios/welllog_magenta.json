{
  "steps": [
    { "op": "vtk_backend" },
    { "op": "load", "path": "/tmp/testdata/Volve_Demo_Wells_Depth.epc", "settle": 10 },
    { "op": "welllog_probe", "cutoff_p50": true, "cutoff_missing": true },
