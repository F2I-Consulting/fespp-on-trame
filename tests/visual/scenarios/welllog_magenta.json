    { "op": "pixel_blame", "rgb": [255, 0, 255], "tol": 8, "expect_none": true,
      "experiments": [
        { "view": { "UseFXAA": 0 } },
        { "rep": { "InterpolateScalarsBeforeMapping": 0 } },
        { "text": { "TextPropMode": "3D Text" } },
        { "text": { "TextPropMode": "2D Text Widget" } },
        { "view": { "UseFXAA": 0 }, "rep": { "InterpolateScalarsBeforeMapping": 0 } }
      ] }
  ]
}
