{
  "steps": [
    { "op": "etp_open", "url": "wss://admeinterop.energy.azure.com/api/reservoir-ddms-etp/v2/",
      "partition": "opendes", "dataspace": "eml:///dataspace('demo/drogon')", "settle": 30 },
    { "op": "dump_tree", "type": "Property", "limit": 30 },
    { "op": "tree_tick", "title": "Geogrid" },
    { "op": "wait", "s": 40 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "render_timing", "label": "ADME whole scene", "frames": 5 },

    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 3 },
    { "op": "card_narrow", "card": "ui_geometry_card__view_1", "method": "geometry_slicer", "box": 0, "fraction": 0.6 },
    { "op": "render_timing", "label": "ADME one box narrowed on its 3 axes", "frames": 5 },
    { "op": "scene_cut_step_timing", "steps": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_box", "mode": "slice"}, "view_1"], "settle": 2 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "add_cut", "box": "b5", "subject": "x"}, "view_1"], "settle": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "cut_cmp", "id": "c9", "cmp": "below"}, "view_1"], "settle": 1 },
    { "op": "render_timing", "label": "ADME two boxes", "frames": 5 },
    { "op": "scene_cut_step_timing", "steps": 3 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "player", "id": "r2", "action": "step", "value": 40}, "view_1"], "settle": 0 },
    { "op": "render_timing", "label": "ADME player step", "frames": 2 },
    { "op": "scene_crop_probe", "pieces": 1 }
  ]
}
