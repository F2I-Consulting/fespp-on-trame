{
  "steps": [
    { "op": "load", "path": "/tmp/testdata/ALK_14Layers.epc", "settle": 12 },
    { "op": "check", "title": "region", "settle": 8 },
    { "op": "activate", "title": "region", "settle": 3 },
    { "op": "reset_camera", "settle": 2 },
    { "op": "dump", "vars": ["ui_geometry_card__view_1"] },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "all_visible", "on": true}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK grid whole", "frames": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r4", "low": -9000, "high": -8600, "live": true}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK: Z -9000..-8600 (live, the hand still down)", "frames": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r4", "low": -8950, "high": -8600, "live": true}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK: Z -8950..-8600 (the min moved: fewer cells)", "frames": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r4", "low": -8460, "high": -8452.0695}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK: Z min pushed to the top (a few cells only)", "frames": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r4", "low": -9381.6779, "high": -9370}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK: Z max pushed to the bottom (a few cells only)", "frames": 1 },
    { "op": "call", "method": "geometry_slicer", "args": [{"op": "set_range", "id": "r2", "low": 4356078, "high": 4390300, "live": true}, "view_1"], "settle": 2 },
    { "op": "render_timing", "label": "ALK: the X range dragged (live)", "frames": 1 }
  ]
}
