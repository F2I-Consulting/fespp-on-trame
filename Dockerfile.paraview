# Toolchain image, tagged paraview:6.0.x: compilers, CMake and a clone of
# paraview-superbuild. It builds nothing itself; the application Dockerfile's
# pvbuild stage runs build.bash on top of it to compile ParaView.
FROM nvidia/opengl:1.2-glvnd-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute

# System packages of the toolchain.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        # Build tools
        software-properties-common \
        build-essential \
        ninja-build \
        git \
        curl \
        wget \
        ca-certificates \
        pkg-config \
        file \
        patchelf \
        # Parser generators
        bison \
        flex \
        # Development libraries
        libgl1-mesa-dev \
        libegl1-mesa-dev \
        libglvnd-dev \
        libegl-dev \
        libgles2-mesa-dev \
        libx11-dev \
        libxext-dev \
        libxt-dev \
        libpng-dev \
        libhdf5-dev \
        zlib1g-dev \
        libpthread-stubs0-dev \
        # GPU runtime libraries
        libegl1 \
        libglvnd0 \
        libgl1 \
        libglx0 \
        libgles2 \
        mesa-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# CMake 3.28.0, from Kitware's binary release.
RUN mkdir -p /opt/cmake/3.28.0 && \
    cd /opt/cmake/3.28.0 && \
    curl -L https://cmake.org/files/v3.28/cmake-3.28.0-linux-x86_64.tar.gz | \
    tar --strip-components=1 -xz && \
    ln -sf /opt/cmake/3.28.0/bin/cmake /usr/bin/cmake && \
    ln -sf /opt/cmake/3.28.0/bin/cpack /usr/bin/cpack && \
    ln -sf /opt/cmake/3.28.0/bin/ctest /usr/bin/ctest

WORKDIR /work
RUN git clone --recursive https://gitlab.kitware.com/paraview/paraview-superbuild.git pvsb-sources

WORKDIR /work