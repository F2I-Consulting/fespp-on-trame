# Prerequisites
*.d

# Local vendored source (e.g. VTK clone for preparing superbuild patches) — never commit
/_local/

# V2 architecture / planning notes (local-only, matches the feature/v2 convention)
/doc/v2/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
/.venv
/fespp_on_trame.egg-info

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# FESPP local source (for local build mode)
/fespp-src-local/
# ParaView Trame Components reference sources (not part of the project)
/paraview-trame-components/
# Private docs (Elba deployment, etc.) — local only, excluded from git
doc/private/
# Private data — local-only EPC/HDF5 test files (Drogon, etc.)
data/private/
# Bilingual user/dev guides — local only (the committed handoff doc is doc/wiki, EN)
doc/EN/
doc/FR/
# French mirror of the developer wiki — local only (the committed wiki is EN)
doc/wiki-fr/
.claude/

# Personal reference notes — accumulated knowledge about ParaView /
# RESQML, kept local so they don't leak into team-wide docs.
/PARAVIEW.md
/RESQML.md
# Personal release smoke-test checklist (local)
/cas_de_test_release.csv

# Container image exports (multi-GB) — never commit, regenerated by docker save
*.tar
# Huge local ParaView/VTK superbuild clones (reverted VTK-patch experiment)
/_local/
# Private / sensitive datasets (real wells, drogon, blockWellbore) — never
# leak to git; also excluded from the Docker build context via .dockerignore
data/private/
# V2 architecture blueprint docs — local only
doc/v2/
# V2 application code is confidential WIP — never commit (leftover untracked
# fespp_on_trame/v2 on a dev checkout must not be added, and V2 must stay unknown)
fespp_on_trame/v2/
# The private deploy kit of one machine (its domain, users and paths) — local
# only; deploy/linux and deploy/apache are the shipped Linux deployment
deploy/caddy/
# Visual-regression artifacts: baselines depend on this machine's GPU
# rendering and partly on private datasets; out/ is per-run output.
tests/visual/baselines/
tests/visual/out/
# Browser smoke test: the driver install and the per-run traces / screenshots.
tests/browser/node_modules/
tests/browser/package-lock.json
tests/browser/out/

# Widgets: JS build artefacts, Python caches, and the virtualenv a widget's
# example is run from (its built bundle, module/serve, is committed)
widgets/**/node_modules/
widgets/**/__pycache__/
widgets/**/dist/
widgets/**/.venv/
# Icon contact sheet: generated from widgets/_shared/icons/fespp-icons.js
# (node scripts/gen_icon_sheet.mjs) — never committed.
widgets/_shared/icons/svg/

# fespp_ia models: brought at install time (ia/get-model.ps1), never committed
/ia/models/

# the RAG corpus and index are built on the machine (ia/build-index.ps1), never committed
ia/corpus_cache/
ia/corpus/*
!ia/corpus/*.md
_archive-*/
# An OSDU store address and its token helpers — local only
adme.json
scripts/adme-token.*
