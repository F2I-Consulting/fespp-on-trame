#!/bin/bash
apt-get -y update && apt-get upgrade -y && \
apt-get install -y \
    libtool \
    libxcb-util-dev \
    libxcb-randr0-dev \
    libxcb1-dev \
    libxcursor-dev \
    libqt5x11extras5-dev \
    libqt5opengl5-dev \
    libqt5help5 \
    qttools5-dev \
    qtxmlpatterns5-dev-tools \
    libqt5svg5-dev \
    qtbase5-dev \
    qtchooser \
    qt5-qmake \
    qtbase5-dev-tools \
    libxkbcommon-x11-dev \
    libgl1-mesa-dev \
    bison flex \
    libxext-dev libxrandr-dev \
    libxcb-util0-dev \
    libxcb-image0-dev libxcb-keysyms1-dev libxcb-render-util0-dev \
    libegl1-mesa-dev libx11-dev libqt5xmlpatterns5
