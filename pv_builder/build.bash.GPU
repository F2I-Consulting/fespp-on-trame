#!/bin/bash

cd /work/pvsb-sources && \
git checkout "${PVSB_GIT_TAG:-'v5.13.3'}" && \
git submodule update --recursive --init && \
cd ..

# Base build options
cmake_options="-DENABLE_mpi=ON -DENABLE_paraviewweb=ON -DPARAVIEW_ENABLE_WEB=ON -DENABLE_python3=ON -DPARAVIEW_USE_PYTHON=ON -DENABLE_occt=ON -DENABLE_numpy=ON -DPARAVIEW_INSTALL_DEVELOPMENT_FILES=ON -DVTK_MODULE_USE_EXTERNAL_VTK_libharu=OFF -DVTK_MODULE_USE_EXTERNAL_VTK_netcdf=OFF"

# Special GPU options
cmake_rendering_option="-DENABLE_egl=ON -DVTK_OPENGL_HAS_EGL=ON -DVTK_USE_X=OFF -DVTK_DEFAULT_RENDER_WINDOW_OFFSCREEN=ON -DVTK_USE_NVCONTROL=OFF -DPARAVIEW_BUILD_WITH_EXTERNAL=ON -DVTK_MODULE_USE_EXTERNAL_VTK_gl2ps=OFF"

export PV_DEBUG_GL=1
export PV_DEBUG_EGL=1
# Install runtime dependencies
apt-get update && apt-get install -y --no-install-recommends \
    libegl1 libglvnd0 libgl1 libglx0 libgles2 \
    libnvidia-gl-525 xvfb && \
rm -rf /var/lib/apt/lists/*

# Build configuration
cmake \
    -B pvsb-build/ \
    -S pvsb-sources/ \
    -G Ninja \
    ${cmake_rendering_option} \
    ${cmake_options} \
    ${ENABLE} \
    -Dllvm_BUILD_SHARED_LIBS=OFF \
    -DPARAVIEW_USE_QT=OFF \
    -DVTK_RENDERING_BACKEND=OpenGL2 \
    ${USE_SYSTEM}

# Build and test
cmake --build pvsb-build --parallel "${PARALLEL_NB:-12}" --target install